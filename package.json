{
  "name": "pi-quiet-tool-calls",
  "version": "0.2.0",
  "description": "Pi extension that collapses every tool call to a single line: one summary per call, click or Ctrl+O to expand.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tool-calls",
    "tui"
  ],
  "license": "MIT",
  "author": "maltoze",
  "type": "module",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maltoze/pi-quiet-tool-calls.git"
  },
  "homepage": "https://github.com/maltoze/pi-quiet-tool-calls#readme",
  "engines": {
    "node": ">=20"
  }
}
